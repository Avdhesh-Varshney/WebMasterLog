# Client environment. Copy to .env: cp .env.example .env

# Backend API base URL. Without this the client calls the deployed API,
# so local accounts (e.g. from `npm run seed:dev`) won't work.
VITE_SERVER_DOMAIN=http://localhost:8000

# Optional: product name shown in the UI (default: Code A2Z).
VITE_ORGANISATION_NAME=Code A2Z
