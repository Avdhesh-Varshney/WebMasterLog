# Server environment. Copy to .env: cp .env.example .env
# Every variable has a local-dev default, so the server also runs without a .env file.

# Port the API listens on. The client's VITE_SERVER_DOMAIN must point here.
PORT=8000

# MongoDB connection string. A standalone local MongoDB is fine.
MONGODB_URL=mongodb://localhost:27017/code-a2z

# Client URL, used to build the /set-password and /accept-invite links.
VITE_CLIENT_DOMAIN=http://localhost:5173

# JWT signing secrets. Use long random strings; set real values in production.
JWT_SECRET_ACCESS_KEY=
JWT_SECRET_REFRESH_KEY=

# Token lifetimes. Keep JWT_REFRESH_EXPIRES_IN_NUM (ms) in sync with JWT_REFRESH_EXPIRES_IN.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_NUM=604800000

# Org whose OWNER gets the platform-admin permission (approve org requests).
# Locally: run `npm run seed:dev` and paste the org id it prints.
PLATFORM_ADMIN_ORG_ID=

# Optional: emails the set-password link when an org request is approved via the admin API.
# Leave empty locally; `npm run approve-request` prints the link instead.
ADMIN_EMAIL=
RESEND_API_KEY=
